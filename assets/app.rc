// QuotaPin resources. Numeric constants are used instead of including
// winver.h / windows.h so the script needs no SDK include paths.

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "QuotaPin"
            VALUE "FileDescription", "QuotaPin - Codex quota tray widget"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "QuotaPin"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "QuotaPin.exe"
            VALUE "ProductName", "QuotaPin"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
